model Therapist {
  id           String            @id @default(uuid()) @db.Uuid
  name         String
  mobile       String
  location     String?
  education    String?
  age          Int
  gender       Gender
  deletedAt    DateTime?
  appointments Appointment[]
  payouts      TherapistPayout[]
  advances     Advance[]        
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([deletedAt])
  @@map("therapist")
}