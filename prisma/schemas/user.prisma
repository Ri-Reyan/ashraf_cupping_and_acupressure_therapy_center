enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Role {
  ADMIN
  RECEPTIONIST
}

enum Status {
  ACTIVE
  BLOCKED
}

model User {
  id           String            @id @db.Uuid
  name         String
  email        String            @unique
  passwordHash String?
  mobile       String
  role         Role
  status       Status
  appointments Appointment[]
  expenses     Expense[]
  payouts      TherapistPayout[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([role, status])
}