enum UserRole {
  ADMIN
  STAFF
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.Text
  email     String   @unique @db.Text
  mobile    Int
  role      UserRole
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @updatedAt @db.Timestamp(6)
}